# Environment example — copy to .env and fill in

NODE_ENV="development"
DATABASE_URL="postgresql://treow:treow@localhost:5432/treow_clinic?schema=public"
AUTH_SECRET="treow-dev-secret-change-me"
# Dedicated audio encryption key (falls back to AUTH_SECRET). Use a long random string in production.
# AUDIO_ENCRYPTION_KEY=

# Public URL of this deployment (https://… in production)
APP_BASE_URL="http://localhost:3000"
SUPPORT_EMAIL="ops@northbank.example"

AI_PROVIDER="mock"
EMAIL_PROVIDER="console"
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=
# EMAIL_FROM="Treow Clinic <bookings@yourdomain.com>"

SMS_PROVIDER="console"
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER="+44…"

# Deposits: console marks paid immediately; stripe uses Checkout
PAYMENT_PROVIDER="console"
# PAYMENT_PROVIDER="stripe"
# STRIPE_SECRET_KEY="sk_test_…"
# STRIPE_WEBHOOK_SECRET=
# OPENAI_API_KEY=
# OPENAI_MODEL="gpt-4o-mini"
# Prefer UK/EU regions for production
# DATA_REGION="uk-eu"
# S3_BUCKET=
# S3_REGION="eu-west-2"
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=   # optional (MinIO / compatible)
# Encrypted audio uses S3 when S3_BUCKET + keys are set; otherwise local web/storage/

# Unattended jobs (reminders, retention, organise drain)
# CRON_SECRET="long-random-string-at-least-24-chars"
# Authorization: Bearer $CRON_SECRET

# AI organise: async (default) enqueues a job; set false to wait in the HTTP request
# AI_ORGANISE_ASYNC="true"
