{
  "name": "treow-native",
  "version": "0.1.0",
  "description": "Treow Clinic installable native shells (iOS, Android, desktop)",
  "main": "index.js",
  "scripts": {
    "config": "node scripts/write-config.mjs",
    "sync": "npm run config && cap sync",
    "add:android": "npm run config && cap add android",
    "add:ios": "npm run config && cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "npm run config && cap run android",
    "run:ios": "npm run config && cap run ios",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
